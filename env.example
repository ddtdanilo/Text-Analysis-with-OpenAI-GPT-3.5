# Required: create a project API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_project_api_key

# Optional: default model used when --model is not supplied
OPENAI_MODEL=gpt-5.6-sol

# Optional: stable, privacy-preserving identifier for an end user.
# Never place an email address, name, API key, or other personal data here.
# OPENAI_SAFETY_IDENTIFIER=sha256-user-identifier
